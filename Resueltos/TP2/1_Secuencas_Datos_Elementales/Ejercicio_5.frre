/* Ejercicio_1.05.
    La secuencia de socios del problema anterior tiene el
    inconveniente de que los números están ordenados pero no son
    correlativos. Se desea generar una secuencia que contenga los
    números de socios que no figuran en la secuencia de socios.
*/
//secuencia indeterminada e impura.

ACCION soc_NO_reg ES
    Ambiente
        sec_soc, sec_NOsoc: secuencia de entero
        soc, aux, i: entero
    Proceso
        ARR(sec_soc)
        AVZ(sec_soc, soc)
        CREAR(sec_NOsoc)

        MIENTRAS (NoFDS(sec_soc)) HACER
            aux := soc
            AVZ(sec_soc, soc)
            SI (NoFDS(sec_soc)) ENTONCES
                SI ((soc - aux) > 1) ENTONCES
                    PARA i := (aux + 1) HASTA (soc - 1) HACER
                        ESCRIBIR(sec_NOsoc,i)
                    FIN_PARA
                FIN_SI
            FIN_SI
        FIN_MIENTRAS
FIN_ACCION
