/* Ejercicio_1.06.
    Dada una secuencia de enteros que almacena la cantidad de
    habitantes de las ciudades capitales de las 23 provincias de la
    República Argentina, discriminados 4 categorías: menores de 18
    años (varones y mujeres) y mayores de 18 años (varones y mujeres).
    Se pide determinar la población total y los siguientes
    porcentajes: masculinos, femeninos, mayores de 18 y menores de 18.
*/
//secuencia pura, 23 elementos

ACCION habitantes_prov ES
    Ambiente
        sec_hab: secuencia de caracter
        h,men_v,men_m,may_v,may_m,pob_total: entero
        
    Proceso
        ESCRIBIR("Calculo de poblacion y porcentajes")
        ARR(sec_hab)
        AVZ(sec_hab, h)
        men_v := 0; men_m := 0; may_v := 0; may_m := 0
        PARA prov := 1 HASTA 23 HACER
            men_v := men_v + h
            AVZ(sec_hab, h)
            men_m := men_m + h
            AVZ(sec_hab, h)
            may_v := may_v + h
            AVZ(sec_hab, h)
            may_m := may_m + h
            AVZ(sec_hab, h)
        FIN_PARA
        pob_total := men_v + men_m + may_v + may_m
        ESCRIBIR("Poblacion total:",pob_total)
        ESCRIBIR("Porcentaje menores varones:", men_v / pob_total * 100)
        ESCRIBIR("Porcentaje menores mujeres:", men_m / pob_total * 100)
        ESCRIBIR("Porcentaje mayores varones:", may_v / pob_total * 100)
        ESCRIBIR("Porcentaje mayores mujeres:", may_m / pob_total * 100)
        CERRAR("sec_hab")
FIN_ACCION